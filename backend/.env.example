MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=https://www.andofood.vn
NODE_ENV=production

# Cloudinary server-side credentials. Never add these to VITE_ variables.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# SMTP Email Configuration (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=Andofoodvn@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
COMPANY_RECEIVE_EMAIL=Andofoodvn@gmail.com
